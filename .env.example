# Required: from app.spatius.ai
SPATIUS_API_KEY=
SPATIUS_APP_ID=
# us-west (default) or your region
SPATIUS_REGION=us-west

# Optional: your own OpenAI key. Without it, WELCOME uses 30 free Spatius starter minutes.
OPENAI_API_KEY=

# Optional: make it yours
WELCOME_COMPANY=Maple Bikes
WELCOME_FACE=julian
WELCOME_LANG=en
WELCOME_QUESTIONS=When are you open?|Can you fix a flat tyre?|Can I return a bike?
# WELCOME_NAME=Julian
# WELCOME_GREETING=Hi, I'm Julian. Ask me anything about Maple Bikes.
# SPATIUS_AVATAR_ID=
# OPENAI_VOICE=ash
# PORT=3000
